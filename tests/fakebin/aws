#!/usr/bin/env bash
# Fake aws CLI for tests. Records every invocation and fakes just enough
# output for deploy.sh to make decisions. Never touches real AWS.
set -euo pipefail

: "${FAKE_AWS_CALL_LOG:?FAKE_AWS_CALL_LOG must be set}"
printf '%s\n' "$*" >>"$FAKE_AWS_CALL_LOG"

service="$1"
sub="$2"

if [[ "$service" == "autoscaling" ]] && [[ "$sub" == "describe-auto-scaling-groups" ]]; then
	if [[ "$*" == *DesiredCapacity* ]]; then
		case "$*" in
		*green-asg*) echo "${FAKE_GREEN_DESIRED:-0}" ;;
		*) echo "${FAKE_BLUE_DESIRED:-0}" ;;
		esac
		exit 0
	fi
	case "$*" in
	*green-asg*) echo "i-green1 i-green2" ;;
	*) echo "i-blue1 i-blue2" ;;
	esac
	exit 0
fi

if [[ "$service" == "elbv2" ]] && [[ "$sub" == "describe-target-health" ]]; then
	if [[ "$*" == *draining* ]]; then
		drain_file="${FAKE_DRAIN_SEQUENCE_FILE:-}"
		if [[ -n "$drain_file" ]] && [[ -s "$drain_file" ]]; then
			head -n 1 "$drain_file"
			tail -n +2 "$drain_file" >"$drain_file.tmp"
			mv "$drain_file.tmp" "$drain_file"
		else
			echo 0
		fi
		exit 0
	fi
	# Unfiltered (no --targets) counts the whole shared group, blue included.
	if [[ "$*" != *--targets* ]]; then
		echo 99
		exit 0
	fi
	sequence_file="${FAKE_HEALTHY_SEQUENCE_FILE:-}"
	if [[ -n "$sequence_file" ]] && [[ -s "$sequence_file" ]]; then
		next=$(head -n 1 "$sequence_file")
		tail -n +2 "$sequence_file" >"$sequence_file.tmp"
		mv "$sequence_file.tmp" "$sequence_file"
	else
		next="${FAKE_HEALTHY_COUNT:-0}"
	fi
	echo "$next"
	exit 0
fi

# All other calls (attach/detach/update-auto-scaling-group) just succeed.
exit 0
